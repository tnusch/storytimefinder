# Required by `python refresh/refresh.py --fetch` - get one at
# https://console.cloud.google.com/apis/credentials (enable "YouTube Data API v3"
# on the project first). Not needed for --sync, which never touches the API.
YOUTUBE_API_KEY=

# Optional - get one at https://console.anthropic.com. Used by --fetch to generate
# each new item's Claude suggestion (description plus best-effort metadata),
# written to data/claude_suggestions.json for manual review. If unset, new items
# are fetched with no suggestions at all.
ANTHROPIC_API_KEY=

# Optional - override default paths used by refresh/refresh.py
STORYTIMEFINDER_DB_PATH=data/storytimefinder.db
STORYTIMEFINDER_CATALOG_PATH=data/catalog.json
STORYTIMEFINDER_SUGGESTIONS_PATH=data/claude_suggestions.json
STORYTIMEFINDER_FETCHED_ITEMS_PATH=data/fetched_items.json
