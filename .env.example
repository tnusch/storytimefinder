# Required by refresh/refresh.py - get one at https://console.cloud.google.com/apis/credentials
# (enable "YouTube Data API v3" on the project first)
YOUTUBE_API_KEY=

# Optional - get one at https://console.anthropic.com. Used to generate each new
# item's description via Claude (instead of using YouTube's raw video/album
# description), plus best-effort metadata suggestions written to
# data/claude_suggestions.json for manual review. If unset, new items sync
# with no description and no suggestions.
ANTHROPIC_API_KEY=

# Optional - override default paths used by refresh/refresh.py
STORYTIMEFINDER_DB_PATH=data/storytimefinder.db
STORYTIMEFINDER_CATALOG_PATH=data/catalog.json
STORYTIMEFINDER_SUGGESTIONS_PATH=data/claude_suggestions.json
